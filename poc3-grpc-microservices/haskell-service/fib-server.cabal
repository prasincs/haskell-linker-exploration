cabal-version:       2.4
name:                fib-server
version:             0.1.0.0
synopsis:            gRPC Fibonacci server in Haskell
license:             MIT
author:              Prasanna
build-type:          Simple

executable fib-server
  main-is:             Server.hs
  build-depends:       base >= 4.14 && < 5
                     , grpc-haskell >= 0.1
                     , grpc-haskell-core >= 0.1
                     , proto-lens >= 0.7
                     , proto-lens-runtime >= 0.7
                     , text >= 1.2
                     , bytestring >= 0.10
                     , async >= 2.2
                     , time >= 1.9
  default-language:    Haskell2010
  ghc-options:         -threaded -rtsopts -with-rtsopts=-N
  hs-source-dirs:      .
